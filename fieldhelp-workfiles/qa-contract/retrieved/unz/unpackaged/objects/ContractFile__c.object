    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>契約主体となる企業。</description>
        <inlineHelpText>The account this contract belongs to.</inlineHelpText>
        <label>取引先</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>契約書</relationshipLabel>
        <relationshipName>Contracts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ContractScope__c</fullName>
        <description>包括、個別。</description>
        <label>契約範囲</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>包括契約 Master Agreement</fullName>
                    <default>false</default>
                    <label>包括契約 Master Agreement</label>
                </value>
                <value>
                    <fullName>個別契約 Individual Contract</fullName>
                    <default>false</default>
                    <label>個別契約 Individual Contract</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ContractType__c</fullName>
        <description>自動更新、単発。</description>
        <inlineHelpText>Automatic renewal or one-time.</inlineHelpText>
        <label>契約種別</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>自動更新 Automatic renewal</fullName>
                    <default>false</default>
                    <label>自動更新 Automatic renewal</label>
                </value>
                <value>
                    <fullName>単発 One-time</fullName>
                    <default>false</default>
                    <label>単発 One-time</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>EndDate__c</fullName>
        <description>契約が終了する日。</description>
        <label>契約終了日</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ExecutionDate__c</fullName>
        <description>契約が締結された日。</description>
        <inlineHelpText>Date the contract was signed (executed).</inlineHelpText>
        <label>締結日</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ExpirationDate__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Enter in months (1 year = 12).</inlineHelpText>
        <label>契約期限(月単位)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>GoogleDriveURL__c</fullName>
        <description>該当書類のDrive格納先。</description>
        <inlineHelpText>Link to the scanned contract file on Google Drive.</inlineHelpText>
        <label>GoogleDriveリンク</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <description>今日が期限内かどうかを判定。</description>
        <formula>EndDate__c &gt;= TODAY()</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>有効性フラグ</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsFileUploaded__c</fullName>
        <defaultValue>false</defaultValue>
        <description>ファイルがアップロードされたら自動でチェックボックスをオンにする</description>
        <inlineHelpText>Indicates the contract document has been uploaded.</inlineHelpText>
        <label>ファイルアップロード済</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>起点となった案件。</description>
        <inlineHelpText>The related project (opportunity).</inlineHelpText>
        <label>譲渡案件</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>契約書（旧譲渡案件）</relationshipLabel>
        <relationshipName>Contracts_Old</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>起点となった案件。</description>
        <inlineHelpText>The related project on the new Project object.</inlineHelpText>
        <label>(新)譲渡案件</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>契約書（新譲渡案件）</relationshipLabel>
        <relationshipName>Contracts_New</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SlackURL__c</fullName>
        <inlineHelpText>Link to the Slack thread requesting the company seal.</inlineHelpText>
        <label>Slack押印申請リンク</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <label>契約書</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>CREATED_DATE</columns>
        <columns>Opportunity__c</columns>
        <columns>Account__c</columns>
        <columns>RECORDTYPE</columns>
        <columns>IsFileUploaded__c</columns>
        <filterScope>Everything</filterScope>
        <label>すべて選択</label>
    </listViews>
    <nameField>
        <label>契約書名</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
