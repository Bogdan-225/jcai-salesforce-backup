    <fields>
        <fullName>TDBAmountOfSales2__c</fullName>
        <externalId>false</externalId>
        <label>TDB前期売上(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBAmountOfSales3__c</fullName>
        <externalId>false</externalId>
        <label>TDB前々期売上高(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBAmountOfSalesAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), 1, 0)
  ) &gt; 0,
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), TDBAmountOfSales3__c, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), TDBAmountOfSales2__c, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), TDBAmountOfSales__c, 0)
  ) /
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), 1, 0)
  ),
  NULL
)</formula>
        <inlineHelpText>3-year average revenue based on TDB data.</inlineHelpText>
        <label>TDB三期売上高平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBAmountOfSales__c</fullName>
        <externalId>false</externalId>
        <label>TDB最新期売上(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
