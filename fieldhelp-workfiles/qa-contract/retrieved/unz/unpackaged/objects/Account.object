    <fields>
        <fullName>NDADateCheck__c</fullName>
        <formula>OR(
  NOT(ISBLANK(NDA_date__c)),
  NOT(ISBLANK(NDA_documents__c))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indicates an NDA is in place.</inlineHelpText>
        <label>NDA</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>NDA_Automatic_Update__c</fullName>
        <inlineHelpText>Whether the NDA renews automatically</inlineHelpText>
        <label>自動更新の有無</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>指定なし</fullName>
                    <default>true</default>
                    <label>指定なし</label>
                </value>
                <value>
                    <fullName>あり</fullName>
                    <default>false</default>
                    <label>あり</label>
                </value>
                <value>
                    <fullName>なし</fullName>
                    <default>false</default>
                    <label>なし</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>NDA_End_Date__c</fullName>
        <inlineHelpText>Date of expiration of the NDA</inlineHelpText>
        <label>NDA終了日</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>NDA_Start_Date__c</fullName>
        <inlineHelpText>Date of start of the NDA</inlineHelpText>
        <label>NDA開始日</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>NDA_Template_Change__c</fullName>
        <label>NDAひな型変更内容</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>NDA_Template__c</fullName>
