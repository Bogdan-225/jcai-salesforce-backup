    <fields>
        <fullName>Profit2__c</fullName>
        <externalId>false</externalId>
        <label>前期税引後利益(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Profit3__c</fullName>
        <externalId>false</externalId>
        <label>前々期税引後利益(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ProfitAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ) &gt; 0,
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), TDBProfit3__c, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), TDBProfit2__c, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), TDBProfit__c, 0)
  ) /
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ),
  NULL
)</formula>
        <label>三期純利益平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Profit__c</fullName>
        <externalId>false</externalId>
        <label>最新期税引後利益(百万円)</label>
