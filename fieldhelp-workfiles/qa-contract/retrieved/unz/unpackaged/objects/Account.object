    <fields>
        <fullName>BuyADContractCheck__c</fullName>
        <formula>AND(
NOT(ISBLANK( BuyAD_date__c  )),
NOT(ISBLANK(  BuyAD_documents__c   )))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>買AD締結日チェック</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>BuyADCrossboaderContractCheck__c</fullName>
        <formula>AND(
NOT(ISBLANK(BuyADCrossboader_documents__c)),
NOT(ISBLANK( BuyADCrossboader_date__c  )))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>クロスボーダー買ADチェック</label>
        <type>Checkbox</type>
    </fields>
