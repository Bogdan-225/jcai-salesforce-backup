    <fields>
        <fullName>SFID18__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>18-character Salesforce ID of this record.</inlineHelpText>
        <label>SFID18</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SearchCapital__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    NOT(ISBLANK(TSRCapital__c)),
    TSRCapital__c,
    IF(
        NOT(ISBLANK(TDBCapital__c)),
        TDBCapital__c,
        0
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>(検索用)資本金</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SearchIndustry__c</fullName>
        <externalId>false</externalId>
        <formula>TSRIndustry1__c &amp;  TSRIndustry2__c &amp;  TSRIndustry3__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>(検索用)TSR業種</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SearchPrefecture__c</fullName>
        <externalId>false</externalId>
        <formula>IF (
  NOT (ISBLANK (TEXT(TSR_prefecture__c))),
  TEXT(TSR_prefecture__c),
  IF (NOT (ISBLANK (TEXT(TDBPrefectures__c))), TEXT(TDBPrefectures__c), &quot;0&quot;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>(検索用)都道府県</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SearchTDBAmountOfSalesAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    TSRAmountOfSales_average__c&lt;&gt;0,
    TSRAmountOfSales_average__c,
    IF(
        TDBAmountOfSalesAvg__c&lt;&gt;0,
        TDBAmountOfSalesAvg__c,
        0
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>(検索用)三期売上高平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
