    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Required_CorporateNumber</fullName>
        <active>true</active>
        <description>国内レコード新規作成時のみ法人番号必須</description>
        <errorConditionFormula>AND(
    ISNEW(),
    RecordType.Name = &quot;国内&quot;,
    ISBLANK( CorporateNumber__c )
)</errorConditionFormula>
        <errorDisplayField>CorporateNumber__c</errorDisplayField>
        <errorMessage>法人番号を入力してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Country</fullName>
        <active>false</active>
        <errorConditionFormula>AND(ISBLANK(TEXT(Country__c)), (RecordType.Name = &quot;International&quot;))</errorConditionFormula>
        <errorDisplayField>Country__c</errorDisplayField>
        <errorMessage>Country is required to create records.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>required_website</fullName>
        <active>false</active>
        <errorConditionFormula>ISNEW() &amp;&amp; ISBLANK(Website)</errorConditionFormula>
        <errorMessage>Websiteは必須です。ない場合は「None」と入れてください</errorMessage>
    </validationRules>
