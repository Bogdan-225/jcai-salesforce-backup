    <fields>
        <fullName>TDBProfit2__c</fullName>
        <externalId>false</externalId>
        <label>TDB前期税引後利益(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBProfit3__c</fullName>
        <externalId>false</externalId>
        <label>TDB前々期税引後利益(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBProfitAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ) &gt; 0,
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), TDBProfit3__c, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), TDBProfit2__c, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), TDBProfit__c, 0)
  ) /
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ),
  NULL
)</formula>
        <inlineHelpText>3-year average after-tax profit based on TDB data.</inlineHelpText>
        <label>TDB三期純利益平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBProfit__c</fullName>
        <externalId>false</externalId>
        <label>TDB最新期税引後利益(百万円)</label>
        <precision>17</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
