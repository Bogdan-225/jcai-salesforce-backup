<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Assign_Account</name>
        <label>取引先から</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContract.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateContractRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_FileCount</name>
        <label>ファイル数をカウント</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>TotalFiles</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>FileUpload_Contract.contentDocIds</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_CheckFileExists</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_NDA_Full_New</name>
        <label>NDA包括(新)から</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContract.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_NewProject.Account__r.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateContractRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_NDA_Full_Old</name>
        <label>NDA包括(旧)から</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContract.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_OldProject.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateContractRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Normal_New</name>
        <label>通常(新)から</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContract.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_NewProject.SFID18__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateContractRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Normal_Old</name>
        <label>通常(旧)から</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContract.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_OldProject.SFID18__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varContract.Project__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateContractRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Exclude_FA</name>
        <label>FA除外を設定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>txtExcludeRecTypeName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FA</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>ContractInputScreen</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_CheckFileExists</name>
        <label>ファイルがあるか確認</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Screen_ContractInput</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>デフォルトの結果</defaultConnectorLabel>
        <rules>
            <name>Has_File</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TotalFiles</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_UploadedFiles</targetReference>
            </connector>
            <label>ファイルあり</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_CreatePattern</name>
        <label>作成時の項目判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateContractRecord</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>デフォルトの結果</defaultConnectorLabel>
        <rules>
            <name>NDA_Full_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isNDAComprehensive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0r</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NDA_Full_New</targetReference>
            </connector>
            <label>NDA包括(新)から</label>
        </rules>
        <rules>
            <name>NDA_Full_Old</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNDAComprehensive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NDA_Full_Old</targetReference>
            </connector>
            <label>NDA包括(旧)から</label>
        </rules>
        <rules>
            <name>Normal_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0r</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNDAComprehensive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Normal_New</targetReference>
            </connector>
            <label>その他(新)から</label>
        </rules>
        <rules>
            <name>Normal_Old</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>006</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNDAComprehensive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Normal_Old</targetReference>
            </connector>
            <label>その他(旧)から</label>
        </rules>
        <rules>
            <name>Account_Pattern</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account</targetReference>
            </connector>
            <label>取引先から</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_TriggerObject</name>
        <label>起動元オブジェクトの判定</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_OldProject</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>譲渡案件から</defaultConnectorLabel>
        <rules>
            <name>From_NewProject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>a0r</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_NewProject</targetReference>
            </connector>
            <label>（新）譲渡から</label>
        </rules>
        <rules>
            <name>From_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Exclude_FA</targetReference>
            </connector>
            <label>取引先から</label>
        </rules>
    </decisions>
    <decisions>
        <name>NDA_Inclusive_Block_Check</name>
        <label>取引先個別契約禁止チェック</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_CreatePattern</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>デフォルトの結果</defaultConnectorLabel>
        <rules>
            <name>NDA_Inclusive_Blocked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContractScope1</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>個別契約 Individual Contract</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>001</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_NDA_Inclusive_Error</targetReference>
            </connector>
            <label>取引先個別契約禁止</label>
        </rules>
    </decisions>
    <description>取引先クイックアクション対応：起動元判定に取引先分岐追加、作成時項目判定に取引先分岐追加 / 取引先の個別契約選択を禁止（包括契約のみ選択可）に修正</description>
    <dynamicChoiceSets>
        <name>ContractScope</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>ContractScope__c</picklistField>
        <picklistObject>ContractFile__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>ContractType</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>ContractType__c</picklistField>
        <picklistObject>ContractFile__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>RecTypeChoices</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ContractFile__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>txtExcludeRecTypeName</elementReference>
            </value>
        </filters>
        <object>RecordType</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>FileCount</name>
        <dataType>Number</dataType>
        <expression>LEN({!FileUpload_Contract.contentDocIds})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>isNDAComprehensive</name>
        <dataType>Boolean</dataType>
        <expression>{!Select_RecType} = {!NDA.Id}
&amp;&amp;
(CONTAINS({!ContractScope1}, &quot;包括&quot;) || CONTAINS({!ContractScope1}, &quot;comprehensive&quot;))</expression>
    </formulas>
    <interviewLabel>契約書作成 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>契約書作成</label>
    <loops>
        <name>Loop_UploadedFiles</name>
        <label>ファイルを1つずつ処理</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>FileUpload_Contract.contentDocIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_UploadedFile</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_ContractName</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>CreateContractRecord</name>
        <label>契約書レコードを作成</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_ContractInput</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>varContract.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContractScope__c</field>
            <value>
                <elementReference>ContractScope1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContractType__c</field>
            <value>
                <elementReference>ContractType1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExecutionDate__c</field>
            <value>
                <elementReference>ExecutionDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpirationDate__c</field>
            <value>
                <elementReference>ExpirationDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <stringValue></stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>varContract.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project__c</field>
            <value>
                <elementReference>varContract.Project__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Select_RecType</elementReference>
            </value>
        </inputAssignments>
        <object>ContractFile__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_NewProject</name>
        <label>（新）譲渡案件を取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Exclude_FA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_OldProject</name>
        <label>譲渡案件を取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Exclude_FA</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_UploadedFile</name>
        <label>アップロードされたファイルを取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_UploadedFiles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContentDocumentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_UploadedFiles</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ContentVersion</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>NDA</name>
        <label>NDAレコードタイプを取得</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_TriggerObject</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ContractFile__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>NDA</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_ContractName</name>
        <label>契約書名をファイル名で更新</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CreateContractRecord</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Get_UploadedFile.Title</elementReference>
            </value>
        </inputAssignments>
        <object>ContractFile__c</object>
    </recordUpdates>
    <screens>
        <name>ContractInputScreen</name>
        <label>契約書入力画面</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>NDA_Inclusive_Block_Check</targetReference>
        </connector>
        <fields>
            <name>Select_RecType</name>
            <choiceReferences>RecTypeChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>契約書の種類</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>ExecutionDate</name>
            <dataType>Date</dataType>
            <fieldText>締結日</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>ExpirationDate</name>
            <dataType>Number</dataType>
            <fieldText>契約期限(ヶ月)</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>ContractType1</name>
            <choiceReferences>ContractType</choiceReferences>
            <dataType>String</dataType>
            <fieldText>契約種別</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>ContractScope1</name>
            <choiceReferences>ContractScope</choiceReferences>
            <dataType>String</dataType>
            <fieldText>契約範囲</fieldText>
            <fieldType>DropdownBox</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Select_RecType</leftValueReference>
                    <operator>NotEqualTo</operator>
                    <rightValue>
                        <stringValue>012RA00000JVogjYAD</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_ContractInput</name>
        <label>契約書ファイルを添付</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Assign_FileCount</targetReference>
        </connector>
        <fields>
            <name>FileUpload_Contract</name>
            <extensionName>forceContent:fileUpload</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>recordId</name>
                <value>
                    <elementReference>CreateContractRecord</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>両社押印済みファイル</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>accept</name>
                <value>
                    <stringValue>.pdf</stringValue>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
            <validationRule>
                <errorMessage>&lt;p&gt;ファイルをアップロードしてください。&lt;/p&gt;</errorMessage>
                <formulaExpression>LEN({!FileUpload_Contract.contentDocIds}) &gt; 0</formulaExpression>
            </validationRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_NDA_Inclusive_Error</name>
        <label>取引先個別契約選択エラー</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Decision_CreatePattern</targetReference>
        </connector>
        <fields>
            <name>ErrMsg_NDA_Inclusive</name>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>取引先からの契約書作成では、個別契約は選択できません（包括契約のみ選択可能です）。「前へ」で戻って入力し直してください。</stringValue>
            </defaultValue>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>NDA</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>TotalFiles</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>txtExcludeRecTypeName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>NONE</stringValue>
        </value>
    </variables>
    <variables>
        <name>varContract</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContractFile__c</objectType>
    </variables>
</Flow>
