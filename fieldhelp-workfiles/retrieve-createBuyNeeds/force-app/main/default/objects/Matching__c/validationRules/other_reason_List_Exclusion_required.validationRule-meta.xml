<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>other_reason_List_Exclusion_required</fullName>
    <active>true</active>
    <description>終了理由にリスト除外が選択された場合、「終了理由コメント」を必須とする</description>
    <errorConditionFormula>AND(INCLUDES(termination_reason__c, &quot;リスト除外&quot;), ISBLANK(other_termination_reason__c))</errorConditionFormula>
    <errorDisplayField>other_termination_reason__c</errorDisplayField>
    <errorMessage>「終了理由コメント」は必須です</errorMessage>
</ValidationRule>
