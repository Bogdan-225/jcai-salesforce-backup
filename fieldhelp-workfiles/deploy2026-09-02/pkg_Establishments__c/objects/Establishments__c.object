<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>SFID18_Establishments__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Id)</formula>
        <inlineHelpText>この事業所レコードの18桁のSalesforce IDです。</inlineHelpText>
        <label>SFID18(事業所)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Estb_DataSource__c</fullName>
        <inlineHelpText>データの取得元：SCUELデータベースか手動検索か。</inlineHelpText>
        <label>事業所_データソース</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>SCUEL</fullName>
                    <default>false</default>
                    <label>SCUEL</label>
                </value>
                <value>
                    <fullName>検索</fullName>
                    <default>false</default>
                    <label>検索</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Integrated__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>この施設が他の施設と同一所在地にある場合にチェックされます。</inlineHelpText>
        <label>併設</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PeriodStart__c</fullName>
        <description>現在の指定の有効期間がスタートした日。
健康保険法第68条により、保険医療機関の指定には「6年」という有効期間が定められており、6年ごとの「更新」を迎えた際の、直近の有効期間の開始日。</description>
        <inlineHelpText>施設の指定期間の開始日（医療・介護保険の指定）。</inlineHelpText>
        <label>指定期間始</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
