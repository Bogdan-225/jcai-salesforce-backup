    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>BuyADContract_URL</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    /* 項目が空白でない場合のみチェックを行う */
    NOT(ISBLANK( BuyADContractURL__c )),

    /* 以下の「許可する条件」のいずれにも当てはまらない(NOT)場合にエラーとする */
    NOT(
        OR(
            /* パターン1: google.com と usp=sharing の両方を含む */
            AND(
                CONTAINS( BuyADContractURL__c , &quot;google.com&quot;),
                CONTAINS( BuyADContractURL__c , &quot;usp=sharing&quot;)
            ),
            /* パターン2: box.com/s/ を含む */
            CONTAINS( BuyADContractURL__c , &quot;box.com/s/&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>BuyADContractURL__c</errorDisplayField>
        <errorMessage>GoogleDriveまたはBOXの[共有]ボタンから共有用URLを挿入してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>DisclosureStatementURLBuy</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    /* 項目が空白でない場合のみチェックを行う */
    NOT(ISBLANK( DisclosureStatementURL_Buy__c )),

    /* 以下の「許可する条件」のいずれにも当てはまらない(NOT)場合にエラーとする */
    NOT(
        OR(
            /* パターン1: google.com と usp=sharing の両方を含む */
            AND(
                CONTAINS( DisclosureStatementURL_Buy__c , &quot;google.com&quot;),
                CONTAINS( DisclosureStatementURL_Buy__c , &quot;usp=sharing&quot;)
            ),
            /* パターン2: box.com/s/ を含む */
            CONTAINS( DisclosureStatementURL_Buy__c , &quot;box.com/s/&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>DisclosureStatementURL_Buy__c</errorDisplayField>
        <errorMessage>GoogleDriveまたはBOXの[共有]ボタンから共有用URLを挿入してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FillApproachMethodWhenApproathSelected</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISBLANK(text( approachMethod__c)  ),
RecordType.DeveloperName =&quot;XBorderType&quot;,
ISpickval( phase_match__c ,&quot;アプローチ&quot;))</errorConditionFormula>
        <errorDisplayField>approachMethod__c</errorDisplayField>
        <errorMessage>フェーズ「アプローチ」を選択時はアプローチ手段を入力してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MustFillIMReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISBLANK(IMPassReason__c ),
ISpickval( phase_match__c ,&quot;IM見送り&quot;),
RecordTypeId =&quot;012BL0000004ICR&quot;
)</errorConditionFormula>
        <errorDisplayField>IMPassReason__c</errorDisplayField>
        <errorMessage>フェーズ「IM見送り」の場合はIM見送り理由を記入してください</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MustFillNNReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISBLANK(NNPassReason__c),
ISPICKVAL(phase_match__c,&quot;NN見送り&quot;),
RecordTypeId =&quot;012BL0000004ICR&quot;)</errorConditionFormula>
        <errorDisplayField>NNPassReason__c</errorDisplayField>
        <errorMessage>フェーズ「NN見送り」の場合はNN見送り理由を記入してください</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_required</fullName>
        <active>true</active>
        <description>[フェーズ]が選択されているとき[ステータス]を必須にする</description>
        <errorConditionFormula>AND(
    RecordType.Name = &apos;国内案件&apos;,
    AND(
        NOT(ISPICKVAL( phase_match__c , &apos;&apos;)), 
        ISPICKVAL( status__c , &apos;&apos;)
    )
)</errorConditionFormula>
        <errorDisplayField>status__c</errorDisplayField>
        <errorMessage>フェーズに応じたステータスを選択してください</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>other_reason_List_Exclusion_required</fullName>
        <active>true</active>
        <description>終了理由にリスト除外が選択された場合、「終了理由コメント」を必須とする</description>
        <errorConditionFormula>AND(INCLUDES(termination_reason__c, &quot;リスト除外&quot;), ISBLANK(other_termination_reason__c))</errorConditionFormula>
        <errorDisplayField>other_termination_reason__c</errorDisplayField>
        <errorMessage>「終了理由コメント」は必須です</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>other_reason_required</fullName>
        <active>true</active>
        <description>終了理由にその他が記載されていた場合、「理由（その他）」を必須とする</description>
        <errorConditionFormula>AND(INCLUDES(termination_reason__c, &quot;その他&quot;), ISBLANK(other_termination_reason__c))</errorConditionFormula>
        <errorDisplayField>other_termination_reason__c</errorDisplayField>
        <errorMessage>「終了理由コメント」は必須です</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>termination_reason_required</fullName>
        <active>true</active>
        <description>終了理由必須の規則</description>
        <errorConditionFormula>AND(
ISPICKVAL(phase_match__c, &quot;マッチ終了&quot;),
ISBLANK(termination_reason__c)
)</errorConditionFormula>
        <errorDisplayField>termination_reason__c</errorDisplayField>
        <errorMessage>マッチ終了を選択した場合、終了理由は必須です。</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
