    <listViews>
        <fullName>AllContacts</fullName>
        <columns>FULL_NAME</columns>
        <columns>ACCOUNT.NAME</columns>
        <columns>Account.TDBPrefectures__c</columns>
        <columns>CONTACT.TITLE</columns>
        <columns>CONTACT.DEPARTMENT</columns>
        <columns>M_AResponsible__c</columns>
        <columns>CONTACT.PHONE3</columns>
        <columns>ACCOUNT.PHONE1</columns>
        <columns>CONTACT.EMAIL</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>UPDATEDBY_USER.ALIAS</columns>
        <columns>CONTACT.LAST_ACTIVITY</columns>
        <columns>CONTACT.LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CONTACT.EMAIL</field>
            <operation>contains</operation>
            <value>@</value>
        </filters>
        <filters>
            <field>CONTACT.PHONE3</field>
            <operation>contains</operation>
            <value>0</value>
        </filters>
        <label>すべての取引先責任者</label>
    </listViews>
    <listViews>
        <fullName>MyContacts</fullName>
        <columns>FULL_NAME</columns>
        <columns>ACCOUNT.NAME</columns>
        <columns>Account.TDBPrefectures__c</columns>
        <columns>CONTACT.TITLE</columns>
        <columns>CONTACT.DEPARTMENT</columns>
        <columns>M_AResponsible__c</columns>
        <columns>CONTACT.PHONE3</columns>
        <columns>ACCOUNT.PHONE1</columns>
        <columns>CONTACT.EMAIL</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>UPDATEDBY_USER.ALIAS</columns>
        <columns>CONTACT.LAST_ACTIVITY</columns>
        <columns>CONTACT.LAST_UPDATE</columns>
        <filterScope>Mine</filterScope>
        <label>私の取引先責任者</label>
    </listViews>
    <listViews>
        <fullName>ZVC__AllContacts</fullName>
        <columns>ACCOUNT.NAME</columns>
        <columns>CREATEDBY_USER.ALIAS</columns>
        <columns>FULL_NAME</columns>
        <columns>CONTACT.TITLE</columns>
        <columns>DepartmentPhone__c</columns>
        <columns>CONTACT.PHONE3</columns>
        <columns>CONTACT.PHONE1</columns>
        <columns>CONTACT.EMAIL</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>CONTACT.LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATEDBY_USER.ALIAS</field>
            <operation>contains</operation>
            <value>IS,moment</value>
        </filters>
        <filters>
            <field>ACCOUNT.NAME</field>
            <operation>notContain</operation>
            <value>テスト</value>
        </filters>
        <label>All Contacts</label>
    </listViews>
    <listViews>
        <fullName>ZVC__BirthdaysThisMonth</fullName>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CONTACT.BIRTHDATE</field>
            <operation>equals</operation>
            <value>THIS_MONTH</value>
        </filters>
        <label>Birthdays This Month</label>
    </listViews>
    <listViews>
        <fullName>ZVC__MyContacts</fullName>
        <filterScope>Mine</filterScope>
        <label>My Contacts</label>
    </listViews>
    <listViews>
        <fullName>ZVC__NewLastWeek</fullName>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CONTACT.CREATED_DATE</field>
            <operation>equals</operation>
            <value>LAST_WEEK</value>
        </filters>
        <label>New Last Week</label>
    </listViews>
    <listViews>
        <fullName>ZVC__NewThisWeek</fullName>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CONTACT.CREATED_DATE</field>
            <operation>equals</operation>
            <value>THIS_WEEK</value>
        </filters>
        <label>New This Week</label>
    </listViews>
