    <searchLayouts>
        <customTabListAdditionalFields>OPPORTUNITY.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>ACCOUNT.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>OPPORTUNITY.CLOSE_DATE</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>OPPORTUNITY.NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>ACCOUNT.NAME</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>OPPORTUNITY.NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>ACCOUNT.NAME</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.STAGE_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Field4__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.FULL_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Field15__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.LAST_ACTIVITY</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.LAST_UPDATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeadType__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>LongTermFollow</fullName>
        <active>true</active>
        <errorConditionFormula>AND(LongTermFollow__c =true,
  OR(
    ISBLANK(LongTermMethod__c),
    ISBLANK(LongTermReason__c)))</errorConditionFormula>
        <errorDisplayField>LongTermFollow__c</errorDisplayField>
        <errorMessage>長期フォローの場合、理由と方法を入力してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PendingValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
Pending__c=true,
ISBLANK(OnHoldReason__c ))</errorConditionFormula>
        <errorDisplayField>Pending__c</errorDisplayField>
        <errorMessage>ペンディングの場合は理由を入力してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_ActivitiesByStage</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    PRIORVALUE(Check_ActivitiesByStage__c) = FALSE
)</errorConditionFormula>
        <errorMessage>フェーズを変更する場合は活動履歴を残してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_CheckFieldsWhenSuccess</fullName>
        <active>true</active>
        <errorConditionFormula>AND(

    ISPICKVAL(StageName, &quot;成約&quot;),
   
    OR(
        Confirm_BuyersBank_POC__c = False,
        Confirm_SellersBank_POC__c = False,
        UpdateShareholderRegistry__c = False,
        VerifyWireTransferPayment__c = False
    )
)</errorConditionFormula>
        <errorMessage>[最終確認]チェック項目をすべて確認してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_FS</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    OR(
        RecordType.DeveloperName = &quot;XBorderType&quot;,
        RecordType.DeveloperName = &quot;CB_Project&quot;
    ),
    ISCHANGED(StageName),
    TEXT(PRIORVALUE(StageName)) = &quot;FS Request&quot;,
    CASE(
        StageName,
        &quot;リード反響&quot;, 1.0,
        &quot;NDA締結&quot;, 2.0,
        &quot;FS Request&quot;, 3.0,
        &quot;バリュエーション済み&quot;, 4.0,
        &quot;案件化&quot;, 5.0,
        &quot;ISマッチング中&quot;, 6.0,
        &quot;MGマッチング中&quot;, 6.0,
        &quot;Pre Top MTG&quot;, 7.0,
        &quot;トップ面談&quot;, 8.0,
        &quot;Post Top MTG&quot;, 9.0,
        &quot;MOU/LOI&quot;, 10.0,
        &quot;DD&quot;, 11.0,
        &quot;SPA&quot;, 12.0,
        &quot;CP&quot;, 13.0,
        &quot;成約&quot;, 14.0,
        &quot;案件終了&quot;, 14.0,
        &quot;Converted to Buyer&quot;, 14.0,
        &quot;On Hold&quot;, 14.0,
        99.0
    ) &gt;= 4.0,
    NOT(
        OR(
            Check_DocUploaded_FS__c,
            AND(
                NOT(ISBLANK(Valuation_Cash__c)),
                NOT(ISBLANK(Valuation_Debt__c)),
                NOT(ISBLANK(Valuation_Depreciation__c)),
                NOT(ISBLANK(Valuation_Equity__c)),
                NOT(ISBLANK(Valuation_PBT__c)),
                NOT(ISBLANK(Valuation_PAT__c)),
                NOT(ISBLANK(Valuation_Revenue__c))
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>FSを[Upload Files]ボタンからアップロード、または[Financial Info]の項目をすべて記入してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_IM</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    OR(
        RecordType.DeveloperName = &quot;DOM_Project&quot;,
        RecordType.DeveloperName = &quot;SellingOpp&quot;
        ),
    ISPICKVAL(StageName, &quot;トップ面談&quot;),
    AND(
        Check_DocUploaded_IM__c = FALSE
    )
)</errorConditionFormula>
        <errorMessage>IMを[Upload Files]ボタンからアップロードしてください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_MANeeds</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    TEXT(StageName) = &quot;Converted to Buyer&quot;,
    ISBLANK(MANeeds__c)
)</errorConditionFormula>
        <errorDisplayField>MANeeds__c</errorDisplayField>
        <errorMessage>[買収ニーズ]オブジェクトからニーズを作成し、[譲渡案件]オブジェクトの[M&amp;A Needs]項目から選択してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_MOU_LOI</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    ISPICKVAL(StageName, &quot;DD&quot;),
    Check_DocUploaded_MOU__c = FALSE
)</errorConditionFormula>
        <errorMessage>LOIとMOUを[Upload Files]ボタンからアップロードしてください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_NameBeginPJ</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;SellingOpp&quot;, 
    RecordType.DeveloperName = &quot;DOM_Project&quot;, 
    ISCHANGED(StageName),
    ISPICKVAL(PRIORVALUE(StageName), &quot;案件化&quot;),
    NOT(BEGINS(Name, &quot;PJ&quot;))
)</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>案件にPJ名をつけてください(例: PJ XXXX)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_OnHoldReason</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(StageName, &quot;On Hold&quot;),
ISPICKVAL(StageName, &quot;保留&quot;)),
ISBLANK(OnHoldReason__c)
)</errorConditionFormula>
        <errorDisplayField>OnHoldReason__c</errorDisplayField>
        <errorMessage>[On-Hold Reason]は必須です。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_PreTopMTG</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    OR(
        RecordType.DeveloperName = &quot;XBorderType&quot;,
        RecordType.DeveloperName = &quot;CB_Project&quot;
        ),
    ISPICKVAL(StageName, &quot;トップ面談&quot;),
    OR(
        Check_DocUploaded_Agenda__c = FALSE,
        Check_DocUploaded_QA__c = FALSE
    )
)</errorConditionFormula>
        <errorMessage>Top Meeting AgendaとQ&amp;A Sheetsを[Upload Files]ボタンからアップロードしてください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_SPA</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    
    OR(

        AND(
            RecordType.DeveloperName = &quot;SellingOpp&quot;, 
            ISPICKVAL(StageName, &quot;成約&quot;),
            Check_DocUploaded_SPA__c = FALSE
        ),
        
        AND(
            RecordType.DeveloperName = &quot;XBorderType&quot;, 
            ISPICKVAL(PRIORVALUE(StageName), &quot;CP&quot;),
            OR(
                Check_DocUploaded_SPA__c = FALSE
            )
        ),

        AND(
            RecordType.DeveloperName = &quot;DOM_Project&quot;, 
            ISPICKVAL(StageName, &quot;成約&quot;),
            Check_DocUploaded_SPA__c = FALSE
        ),
        
        AND(
            RecordType.DeveloperName = &quot;CB_Project&quot;, 
            ISPICKVAL(PRIORVALUE(StageName), &quot;CP&quot;),
            OR(
                Check_DocUploaded_SPA__c = FALSE
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>SPAを[Upload Files]ボタンからアップロードしてください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Teaser_MatchingStage</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    OR(
        AND(
            OR(
                RecordType.DeveloperName = &quot;XBorderType&quot;,
                RecordType.DeveloperName = &quot;CB_Project&quot;
            ),
            CASE(
                PRIORVALUE(StageName),
                &quot;リード反響&quot;, 1.0,
                &quot;NDA締結&quot;, 2.0,
                &quot;FS Request&quot;, 3.0,
                &quot;バリュエーション済み&quot;, 4.0,
                &quot;案件化&quot;, 5.0,
                &quot;ISマッチング中&quot;, 6.0,
                &quot;MGマッチング中&quot;, 6.0,
                &quot;Pre Top MTG&quot;, 7.0,
                &quot;トップ面談&quot;, 8.0,
                &quot;Post Top MTG&quot;, 9.0,
                &quot;MOU/LOI&quot;, 10.0,
                &quot;DD&quot;, 11.0,
                &quot;SPA&quot;, 12.0,
                &quot;CP&quot;, 13.0,
                &quot;成約&quot;, 14.0,
                &quot;案件終了&quot;, 14.0,
                &quot;Converted to Buyer&quot;, 14.0,
                &quot;On Hold&quot;, 14.0,
                99.0
            ) &gt;= 5.0,
            CASE(
                StageName,
                &quot;リード反響&quot;, 1.0,
                &quot;NDA締結&quot;, 2.0,
                &quot;FS Request&quot;, 3.0,
                &quot;バリュエーション済み&quot;, 4.0,
                &quot;案件化&quot;, 5.0,
                &quot;ISマッチング中&quot;, 6.0,
                &quot;MGマッチング中&quot;, 6.0,
                &quot;Pre Top MTG&quot;, 7.0,
                &quot;トップ面談&quot;, 8.0,
                &quot;Post Top MTG&quot;, 9.0,
                &quot;MOU/LOI&quot;, 10.0,
                &quot;DD&quot;, 11.0,
                &quot;SPA&quot;, 12.0,
                &quot;CP&quot;, 13.0,
                &quot;成約&quot;, 14.0,
                &quot;案件終了&quot;, 14.0,
                &quot;Converted to Buyer&quot;, 14.0,
                &quot;On Hold&quot;, 14.0,
                99.0
            ) &gt;= 6.0,
            OR(
                Check_DocUploaded_Teaser__c = FALSE,
                Check_MatchingStage__c = FALSE
            )
        ),
        AND(
            OR(
                RecordType.DeveloperName = &quot;SellingOpp&quot;,
                RecordType.DeveloperName = &quot;DOM_Project&quot;
            ),
            CASE(
                PRIORVALUE(StageName),
                &quot;IS戻し&quot;, 1.0,
                &quot;トスアップ&quot;, 1.0,
                &quot;面談前&quot;, 2.0,
                &quot;長期フォロー&quot;, 3.0,
                &quot;案件化&quot;, 3.0,
                &quot;資料作成&quot;, 4.0,
                &quot;ISマッチング中&quot;, 5.0,
                &quot;MGマッチング中&quot;, 5.0,
                &quot;トップ面談&quot;, 6.0,
                &quot;MOU/LOI&quot;, 7.0,
                &quot;DD&quot;, 8.0,
                &quot;SPA&quot;, 9.0,
                &quot;成約&quot;, 10.0,
                &quot;案件終了&quot;, 10.0,
                99.0
            ) &gt;= 4.0,
            CASE(
                StageName,
                &quot;IS戻し&quot;, 1.0,
                &quot;トスアップ&quot;, 1.0,
                &quot;面談前&quot;, 2.0,
                &quot;長期フォロー&quot;, 3.0,
                &quot;案件化&quot;, 3.0,
                &quot;資料作成&quot;, 4.0,
                &quot;ISマッチング中&quot;, 5.0,
                &quot;MGマッチング中&quot;, 5.0,
                &quot;トップ面談&quot;, 6.0,
                &quot;MOU/LOI&quot;, 7.0,
                &quot;DD&quot;, 8.0,
                &quot;SPA&quot;, 9.0,
                &quot;成約&quot;, 10.0,
                &quot;案件終了&quot;, 10.0,
                99.0
            ) &gt;= 5.0,
            Check_DocUploaded_Teaser__c = FALSE
        )
    )
)</errorConditionFormula>
        <errorMessage>国内案件はTeaserを[Upload Files]ボタンからアップロードしてください。CB案件はTeaserに加え、マッチング中の買い手のフェーズを[NN開示済み]に変更してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_TopMeetingDate</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    RecordType.Name = &quot;Project&quot;,
    ISPICKVAL(StageName, &quot;トップ面談&quot;),
    ISBLANK(  CB_P_TopMeetingDate__c  )
)</errorConditionFormula>
        <errorDisplayField>CB_P_TopMeetingDate__c</errorDisplayField>
        <errorMessage>Top Meeting Date is required to change the stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_TossUpDate</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    RecordType.Name = &quot;Project&quot;,
    ISPICKVAL(StageName, &quot;案件化&quot;),
    ISBLANK( CB_P_TossupDate__c )
)</errorConditionFormula>
        <errorDisplayField>CB_P_TossupDate__c</errorDisplayField>
        <errorMessage>Toss Up Date is required to change the stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_Valuation</fullName>
        <active>false</active>
        <description>フェーズ:Valuationから進めるときにValuation Excel SheetsかValuation項目を必須化する。</description>
        <errorConditionFormula>AND(
    OR(
        RecordType.DeveloperName = &quot;XBorderType&quot;,
        RecordType.DeveloperName = &quot;CB_Project&quot;
    ),
    ISCHANGED(StageName),
    CASE(
        PRIORVALUE(StageName),
        &quot;リード反響&quot;, 1.0,
        &quot;NDA締結&quot;, 2.0,
        &quot;FS Request&quot;, 3.0,
        &quot;バリュエーション済み&quot;, 4.0,
        &quot;案件化&quot;, 5.0,
        &quot;ISマッチング中&quot;, 6.0,
        &quot;MGマッチング中&quot;, 6.0,
        &quot;Pre Top MTG&quot;, 7.0,
        &quot;トップ面談&quot;, 8.0,
        &quot;Post Top MTG&quot;, 9.0,
        &quot;MOU/LOI&quot;, 10.0,
        &quot;DD&quot;, 11.0,
        &quot;SPA&quot;, 12.0,
        &quot;CP&quot;, 13.0,
        &quot;成約&quot;, 14.0,
        &quot;案件終了&quot;, 14.0,
        &quot;Converted to Buyer&quot;, 14.0,
        &quot;On Hold&quot;, 14.0,
        99.0
    ) &gt;= 4.0,
    CASE(
        StageName,
        &quot;リード反響&quot;, 1.0,
        &quot;NDA締結&quot;, 2.0,
        &quot;FS Request&quot;, 3.0,
        &quot;バリュエーション済み&quot;, 4.0,
        &quot;案件化&quot;, 5.0,
        &quot;ISマッチング中&quot;, 6.0,
        &quot;MGマッチング中&quot;, 6.0,
        &quot;Pre Top MTG&quot;, 7.0,
        &quot;トップ面談&quot;, 8.0,
        &quot;Post Top MTG&quot;, 9.0,
        &quot;MOU/LOI&quot;, 10.0,
        &quot;DD&quot;, 11.0,
        &quot;SPA&quot;, 12.0,
        &quot;CP&quot;, 13.0,
        &quot;成約&quot;, 14.0,
        &quot;案件終了&quot;, 14.0,
        &quot;Converted to Buyer&quot;, 14.0,
        &quot;On Hold&quot;, 14.0,
        99.0
    ) &gt;= 4.0,
    OR(
        Check_DocUploaded_Valuation__c = FALSE,
        ISBLANK(EV_USDmm__c),
        ISBLANK(Valuation_Methods__c)
    )
)</errorConditionFormula>
        <errorMessage>Valuation Excel Sheetsを[Upload Files]ボタンからアップロードし、[Valuation Info]の項目をすべて記入してください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_ValuationDate</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;XBorderType&quot;,
    ISCHANGED(StageName),
    ISPICKVAL(PRIORVALUE(StageName), &quot;案件化&quot;),
    ISBLANK( Valuation_Date__c )
)</errorConditionFormula>
        <errorDisplayField>Valuation_Date__c</errorDisplayField>
        <errorMessage>Valuation Date is required to change the stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SellADContract_URL</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    /* 項目が空白でない場合のみチェックを行う */
    NOT(ISBLANK( SellADContract_URL__c )),

    /* 以下の「許可する条件」のいずれにも当てはまらない(NOT)場合にエラーとする */
    NOT(
        OR(
            /* パターン1: google.com と usp=sharing の両方を含む */
            AND(
                CONTAINS( SellADContract_URL__c , &quot;google.com&quot;),
                CONTAINS( SellADContract_URL__c , &quot;usp=sharing&quot;)
            ),
            /* パターン2: box.com/s/ を含む */
            CONTAINS( SellADContract_URL__c , &quot;box.com/s/&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>SellADContract_URL__c</errorDisplayField>
        <errorMessage>GoogleDriveまたはBOXの[共有]ボタンから共有用URLを挿入してください。
(※BOXの場合: 共有の有効期限を解除([リンク設定]&gt; [リンクの有効期限]&gt; [チェックを外す])</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SharingURL</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    /* 項目が空白でない場合のみチェックを行う */
    NOT(ISBLANK( DisclosureStatementURL_Sell__c )),

    /* 以下の「許可する条件」のいずれにも当てはまらない(NOT)場合にエラーとする */
    NOT(
        OR(
            /* パターン1: google.com と usp=sharing の両方を含む */
            AND(
                CONTAINS( DisclosureStatementURL_Sell__c , &quot;google.com&quot;),
                CONTAINS( DisclosureStatementURL_Sell__c , &quot;usp=sharing&quot;)
            ),
            /* パターン2: box.com/s/ を含む */
            CONTAINS( DisclosureStatementURL_Sell__c , &quot;box.com/s/&quot;)
        )
    )
)</errorConditionFormula>
        <errorDisplayField>DisclosureStatementURL_Sell__c</errorDisplayField>
        <errorMessage>GoogleDriveまたはBOXの[共有]ボタンから共有用URLを挿入してください。
(※BOXの場合: 共有の有効期限を解除([リンク設定]&gt; [リンクの有効期限]&gt; [チェックを外す])</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>required_website</fullName>
        <active>true</active>
        <description>Account.Websiteが空の場合作成不可</description>
        <errorConditionFormula>ISNEW() &amp;&amp; ISBLANK(SP_Website__c)</errorConditionFormula>
        <errorMessage>作成元取引先のWebsiteが空です。ない場合はNoneと入れてください。</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>termination_reason_length</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;案件終了&quot;),
LEN(termination_reason__c) &lt;= 99
)</errorConditionFormula>
        <errorDisplayField>termination_reason__c</errorDisplayField>
        <errorMessage>終了理由は100文字以上入力してください</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>termination_reason_required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(StageName, &quot;案件終了&quot;),
ISBLANK(termination_reason__c)
)</errorConditionFormula>
        <errorDisplayField>termination_reason__c</errorDisplayField>
        <errorMessage>終了理由は必須です</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>slackv2__Send_to_Slack</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Send to Slack</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <url>/apex/{!$Setup.slackv2__Setup_Settings__c.slackv2__Namespace_Api__c}sendToSlack?recordId={!CASESAFEID (Opportunity.Id)}&amp;objectApiName=Opportunity</url>
    </webLinks>
    <webLinks>
        <fullName>slackv2__Slack_Alerts</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <height>600</height>
        <linkType>url</linkType>
        <masterLabel>Slack Alerts</masterLabel>
        <openType>noSidebar</openType>
        <protected>false</protected>
        <url>/apex/{!$Setup.slackv2__Setup_Settings__c.slackv2__Namespace_Api__c}slackAlerts?recordId={!CASESAFEID (Opportunity.Id)}&amp;objectApiName=Opportunity</url>
    </webLinks>
</CustomObject>
