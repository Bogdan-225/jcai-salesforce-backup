    <fields>
        <fullName>opportunity_acquirer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>商談獲得担当者</label>
        <referenceTo>User</referenceTo>
        <relationshipName>opportunity_acquirer</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>predictiveAmount__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( 
     Field4__c ,
       &quot;D0%&quot; , 0, 
       &quot;C20%&quot; , 0.2,
       &quot;B50%&quot; , 0.5,
       &quot;A80%&quot; , 0.8,
   0)* Field16__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>確度勘案後売上高(M)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>termination_reason__c</fullName>
        <label>終了理由(100字以上)</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>TextArea</type>
    </fields>
