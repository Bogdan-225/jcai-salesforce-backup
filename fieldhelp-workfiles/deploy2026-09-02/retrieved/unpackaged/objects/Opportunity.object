    <fields>
        <fullName>CB_P_AcquiringCompany__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>CB(Cross Border)レコードタイプのP(Project)オブジェクト用。
MOUフェーズ以降に相手(買収企業)を指定するための項目。</description>
        <inlineHelpText>Select the buyers who are in the final stages or closing.</inlineHelpText>
        <label>Acquiring Company</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Acquiring Company</relationshipLabel>
        <relationshipName>AcquiringCompany</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CB_P_Appointment__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK(CB_P_ResponseDate__c)), 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Appointment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CB_P_PotentialBuyers__c</fullName>
        <label>Potential Buyers</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>CB_P_ResponseDate__c</fullName>
