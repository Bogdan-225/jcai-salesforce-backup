        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CB_ExpectedRevenue_Yen__c</fullName>
        <externalId>false</externalId>
        <formula>CB_ExpectedPayout_Yen__c * Probability</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Expected Revenue(万円)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
