    <fields>
        <fullName>TDBSubCategory__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>TDBの業種小分類。</inlineHelpText>
        <label>小分類</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBSubclassification__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>TDBの業種細分類。</inlineHelpText>
        <label>細分類</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBSettlementYearMonth__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>TDB財務データの最新期（年月）。</inlineHelpText>
        <label>TDB最新期</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBAmountOfSalesAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), 1, 0)
  ) &gt; 0,
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), TDBAmountOfSales3__c, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), TDBAmountOfSales2__c, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), TDBAmountOfSales__c, 0)
  ) /
  (
    IF(NOT(ISBLANK(TDBAmountOfSales3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBAmountOfSales__c)), 1, 0)
  ),
  NULL
)</formula>
        <inlineHelpText>TDBデータに基づく3期平均売上高。</inlineHelpText>
        <label>TDB三期売上高平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TDBProfitAvg__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ) &gt; 0,
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), TDBProfit3__c, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), TDBProfit2__c, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), TDBProfit__c, 0)
  ) /
  (
    IF(NOT(ISBLANK(TDBProfit3__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit2__c)), 1, 0) +
    IF(NOT(ISBLANK(TDBProfit__c)), 1, 0)
  ),
  NULL
)</formula>
        <inlineHelpText>TDBデータに基づく3期平均税引後利益。</inlineHelpText>
        <label>TDB三期純利益平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
