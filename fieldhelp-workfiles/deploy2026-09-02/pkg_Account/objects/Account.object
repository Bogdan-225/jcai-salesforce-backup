    <fields>
        <fullName>FundStatus__c</fullName>
        <inlineHelpText>このファンドへの現在のアプローチ状況。</inlineHelpText>
        <label>Fund Status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
