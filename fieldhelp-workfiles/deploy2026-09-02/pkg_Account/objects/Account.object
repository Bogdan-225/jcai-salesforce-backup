    <fields>
        <fullName>SFID18__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>このレコードの18桁のSalesforce IDです。</inlineHelpText>
        <label>SFID18</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>stock_code__c</fullName>
        <externalId>false</externalId>
