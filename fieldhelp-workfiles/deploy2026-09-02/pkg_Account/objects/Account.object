    <fields>
        <fullName>TSRAmountOfSales3__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>決算期3の売上高。</inlineHelpText>
        <label>TSR売上(百万円)3</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TSRAmountOfSales_average__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    AND(
        TSRAmountOfSales1__c=0,
        TSRAmountOfSales2__c=0,
        TSRAmountOfSales3__c=0
    ),
    0,
    (
        IF(OR(ISBLANK(TSRAmountOfSales1__c), TSRAmountOfSales1__c = 0), 0, TSRAmountOfSales1__c) +
        IF(OR(ISBLANK(TSRAmountOfSales2__c), TSRAmountOfSales2__c = 0), 0, TSRAmountOfSales2__c) +
        IF(OR(ISBLANK(TSRAmountOfSales3__c), TSRAmountOfSales3__c = 0), 0, TSRAmountOfSales3__c)
    )
    /
    (
        IF(OR(ISBLANK(TSRAmountOfSales1__c), TSRAmountOfSales1__c = 0), 0, 1) +
        IF(OR(ISBLANK(TSRAmountOfSales2__c), TSRAmountOfSales2__c = 0), 0, 1) +
        IF(OR(ISBLANK(TSRAmountOfSales3__c), TSRAmountOfSales3__c = 0), 0, 1)
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>TSRデータに基づく3期平均売上高。</inlineHelpText>
        <label>TSR三期売上高平均</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
