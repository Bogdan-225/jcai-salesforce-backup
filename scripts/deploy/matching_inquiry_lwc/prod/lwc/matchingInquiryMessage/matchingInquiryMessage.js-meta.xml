<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Inquiry Message (from Project)</masterLabel>
    <description>Read-only Inquiry fields of the Matching's Project (Opportunity), shown even when the Project itself is not shared with the user.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Matching__c</object>
            </objects>
            <property name="jaTitle" type="String" default="問い合わせ項目(日本語)" label="Japanese section title"/>
            <property name="enTitle" type="String" default="問い合わせ項目(English)" label="English section title"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
