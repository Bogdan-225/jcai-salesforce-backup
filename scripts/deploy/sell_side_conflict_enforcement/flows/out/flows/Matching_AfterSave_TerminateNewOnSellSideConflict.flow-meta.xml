<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>新規マッチングがアプローチ段階で、買い手が既に進行中売り手(Account.SellSideConflict__c)の時、そのマッチングを自動終了する。Sato作 Matching_AfterSave_TerminateNewOnConflict のミラー(2026-10-19)。</description>
    <environments>Default</environments>
    <interviewLabel>Matching AfterSave Terminate New On SellSideConflict {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Matching AfterSave Terminate New On SellSideConflict</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Account_Event_N</name>
        <label>Create Account Activity (Seller Conflict)</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>TermDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DurationInMinutes</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsAllDayEvent</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDateTime</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TermSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Buy_Company__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>activity_type__c</field>
            <value>
                <stringValue>メモ</stringValue>
            </value>
        </inputAssignments>
        <object>Event</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Activity</name>
        <label>Create Activity (Seller Conflict)</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>Create_Account_Event_N</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>TermDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>完了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TermSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>activity_type__c</field>
            <value>
                <stringValue>メモ</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>call_date_and_time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_SourceOpp</name>
        <label>Get Source Opportunity (seller's active deal)</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Terminate_Self</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>SellSideActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Buy_Company__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>SellSideSellerParentId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Buy_Company__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <sortField>SellSideBaseDate__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Terminate_Self</name>
        <label>Terminate This Matching</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Create_Activity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SellSideAutoTerminated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SellSideConflictSourceName__c</field>
            <value>
                <elementReference>Get_SourceOpp.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SellSideConflictWarned__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>other_termination_reason__c</field>
            <value>
                <stringValue>売り手として進行中のため</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>phase_match__c</field>
            <value>
                <stringValue>マッチ終了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>status__c</field>
            <value>
                <stringValue>アプローチ&gt;終了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>termination_reason__c</field>
            <value>
                <stringValue>リスト除外</stringValue>
            </value>
        </inputAssignments>
        <object>Matching__c</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_SourceOpp</targetReference>
        </connector>
        <filterFormula>AND( ISNEW(), TEXT({!$Record.phase_match__c}) = &quot;アプローチ&quot;, {!$Record.Buy_Company__r.SellSideConflict__c} = TRUE, {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;CB_Target&quot;, NOT(OR( TEXT({!$Record.Sell__r.StageName})=&quot;成約&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;案件終了&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;On Hold&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;Converted to Buyer&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;成約&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;案件終了&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;On Hold&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;Converted to Buyer&quot; )) )</filterFormula>
        <object>Matching__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>TermDesc</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!Get_SourceOpp.Name}: {!Get_SourceOpp.Id}
Seller Conflict: this buyer is active in another deal (Top-Meeting stage or later). Beware of duplicate proposals.
この買い手は他案件でTopMeeting以降で進行中。重複提案に注意。</text>
    </textTemplates>
    <textTemplates>
        <name>TermSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Seller Conflict: {!Get_SourceOpp.Name}</text>
    </textTemplates>
</Flow>
