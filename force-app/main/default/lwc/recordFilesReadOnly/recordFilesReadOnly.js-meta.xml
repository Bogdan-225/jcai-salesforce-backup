<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Files (read-only)</masterLabel>
    <description>Lists the files attached to the record with preview links and no Add/Upload buttons.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" default="Files" label="Card title"/>
            <property name="pageSize" type="Integer" default="20" min="1" max="100" label="Max files shown"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
