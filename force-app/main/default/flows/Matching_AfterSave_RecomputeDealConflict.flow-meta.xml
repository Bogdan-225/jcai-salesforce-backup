    <decisions>
        <name>Decision_BuyerChanged</name>
        <label>Buyer Changed?</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Buy_Company__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Buy_Company__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Buy_Company__c</elementReference>
                </rightValue>
            </conditions>
