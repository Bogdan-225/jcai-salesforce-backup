<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>新規マッチングがアプローチ段階で、買い手が既にDealConflict=trueの時、そのマッチングを自動終了(マッチ終了/アプローチ&gt;終了/リスト除外/他案件進行中のため)し、活動履歴(メモ)を残す。件名・終了理由には重複元(Get_ConflictSrc)の案件名を使用しConflictSourceName__cに記録する。</description>
    <environments>Default</environments>
    <formulas>
        <name>ConflictSrcId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_ConflictSrc.Sell__c}), CASESAFEID({!Get_ConflictSrc.Sell_New__c}), CASESAFEID({!Get_ConflictSrc.Sell__c}))</expression>
    </formulas>
    <interviewLabel>Matching AfterSave Terminate New On Conflict {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Matching AfterSave Terminate New On Conflict</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Account_Event_N</name>
        <label>Create Account Activity (Deal Conflict)</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>TermDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DurationInMinutes</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsAllDayEvent</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDateTime</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TermSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Buy_Company__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>activity_type__c</field>
            <value>
                <stringValue>メモ</stringValue>
            </value>
        </inputAssignments>
        <object>Event</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Activity</name>
        <label>Create Activity (Deal Conflict)</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>Create_Account_Event_N</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>TermDesc</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>完了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TermSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>activity_type__c</field>
            <value>
                <stringValue>メモ</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>call_date_and_time__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_ConflictSrc</name>
        <label>Get Conflict Source</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Terminate_Self</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6 OR 7 OR 8)</filterLogic>
        <filters>
            <field>Buy_Company__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Buy_Company__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Deal_Is_TopStage__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>トップ面談</stringValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Q&amp;A_PreDD</stringValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MOU/LOI</stringValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DD</stringValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SPA</stringValue>
            </value>
        </filters>
        <filters>
            <field>phase_match__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CP</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Matching__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>DealName__c</queriedFields>
        <queriedFields>Sell__c</queriedFields>
        <queriedFields>Sell_New__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Terminate_Self</name>
        <label>Terminate This Matching</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <connector>
            <targetReference>Create_Activity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AutoTerminated__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ConflictSourceName__c</field>
            <value>
                <elementReference>Get_ConflictSrc.DealName__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DealConflictWarned__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>other_termination_reason__c</field>
            <value>
                <stringValue>他案件進行中のため</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>phase_match__c</field>
            <value>
                <stringValue>マッチ終了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>status__c</field>
            <value>
                <stringValue>アプローチ&gt;終了</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>termination_reason__c</field>
            <value>
                <stringValue>リスト除外</stringValue>
            </value>
        </inputAssignments>
        <object>Matching__c</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_ConflictSrc</targetReference>
        </connector>
        <filterFormula>AND( ISNEW(), TEXT({!$Record.phase_match__c}) = &quot;アプローチ&quot;, {!$Record.Buy_Company__r.DealConflict__c} = TRUE, {!$Record.RecordType.DeveloperName} &lt;&gt; &quot;CB_Target&quot;, NOT(OR( TEXT({!$Record.Sell__r.StageName})=&quot;成約&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;案件終了&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;On Hold&quot;, TEXT({!$Record.Sell__r.StageName})=&quot;Converted to Buyer&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;成約&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;案件終了&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;On Hold&quot;, TEXT({!$Record.Sell_New__r.StageName__c})=&quot;Converted to Buyer&quot; )) )</filterFormula>
        <object>Matching__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>TermDesc</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!Get_ConflictSrc.DealName__c}: {!ConflictSrcId}
Deal Conflict: this buyer is active in another deal (Top-Meeting stage or later). Beware of duplicate proposals.
この買い手は他案件でTopMeeting以降で進行中。重複提案に注意。</text>
    </textTemplates>
    <textTemplates>
        <name>TermSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Deal Conflict: {!Get_ConflictSrc.DealName__c}</text>
    </textTemplates>
</Flow>
