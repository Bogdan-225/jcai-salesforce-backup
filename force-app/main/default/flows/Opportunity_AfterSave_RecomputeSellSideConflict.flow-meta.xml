    <decisions>
        <name>Which_Account_Ids</name>
        <label>Which Account Ids Are Present</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Neither</defaultConnectorLabel>
        <rules>
            <name>Both_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Recalculate_Both</targetReference>
            </connector>
            <label>Both present</label>
        </rules>
        <rules>
            <name>Current_Only</name>
            <conditionLogic>and</conditionLogic>
