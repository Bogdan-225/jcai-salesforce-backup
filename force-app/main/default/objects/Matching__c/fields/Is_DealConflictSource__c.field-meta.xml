<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_DealConflictSource__c</fullName>
    <description>このマッチ自身が重複元か(マッチのフェーズがトップ面談〜CP かつ 案件ステージもトップ面談〜CP)。非重複元(=活動作成対象)の判定に使用。内部・DealConflict管理用。</description>
    <formula>AND(
Deal_Is_TopStage__c,
CASE(TEXT(phase_match__c), &quot;トップ面談&quot;,1, &quot;Q&amp;A_PreDD&quot;,1, &quot;MOU/LOI&quot;,1, &quot;DD&quot;,1, &quot;SPA&quot;,1, &quot;CP&quot;,1, 0)=1
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>重複元マッチ(自動判定)</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
