<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PendingValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
Pending__c=true,
ISBLANK(OnHoldReason__c ))</errorConditionFormula>
    <errorDisplayField>Pending__c</errorDisplayField>
    <errorMessage>ペンディングの場合は理由を入力してください。</errorMessage>
</ValidationRule>
