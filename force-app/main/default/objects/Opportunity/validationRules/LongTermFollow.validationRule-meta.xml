<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LongTermFollow</fullName>
    <active>true</active>
    <errorConditionFormula>AND(LongTermFollow__c =true,
  OR(
    ISBLANK(LongTermMethod__c),
    ISBLANK(LongTermReason__c)))</errorConditionFormula>
    <errorDisplayField>LongTermFollow__c</errorDisplayField>
    <errorMessage>長期フォローの場合、理由と方法を入力してください。</errorMessage>
</ValidationRule>
