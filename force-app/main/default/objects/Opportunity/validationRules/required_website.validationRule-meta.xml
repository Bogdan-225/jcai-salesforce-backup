<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>required_website</fullName>
    <active>true</active>
    <description>Account.Websiteが空の場合作成不可</description>
    <errorConditionFormula>ISNEW() &amp;&amp; ISBLANK(SP_Website__c)</errorConditionFormula>
    <errorMessage>作成元取引先のWebsiteが空です。ない場合はNoneと入れてください。</errorMessage>
</ValidationRule>
