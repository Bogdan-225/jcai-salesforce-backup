<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_ActivitiesByStage</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(StageName),
    PRIORVALUE(Check_ActivitiesByStage__c) = FALSE
)</errorConditionFormula>
    <errorMessage>フェーズを変更する場合は活動履歴を残してください。</errorMessage>
</ValidationRule>
