<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CB_AverageRevenueUSDmm__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
(
IF(NOT(ISBLANK(CB_CurrentRevenueUSDmm__c)), 1, 0) +
IF(NOT(ISBLANK(CB_PreviousPeriodRevenue_USDmm__c)), 1, 0) +
IF(NOT(ISBLANK(CB_TwoPeriodsPrior_RevenueUSDmm__c)), 1, 0)
) &gt; 0,
(
IF(NOT(ISBLANK(CB_CurrentRevenueUSDmm__c)), CB_CurrentRevenueUSDmm__c, 0) +
IF(NOT(ISBLANK(CB_PreviousPeriodRevenue_USDmm__c)), CB_PreviousPeriodRevenue_USDmm__c, 0) +
IF(NOT(ISBLANK(CB_TwoPeriodsPrior_RevenueUSDmm__c)), CB_TwoPeriodsPrior_RevenueUSDmm__c, 0)
) /
(
IF(NOT(ISBLANK(CB_CurrentRevenueUSDmm__c)), 1, 0) +
IF(NOT(ISBLANK(CB_PreviousPeriodRevenue_USDmm__c)), 1, 0) +
IF(NOT(ISBLANK(CB_TwoPeriodsPrior_RevenueUSDmm__c)), 1, 0)
),
NULL
)</formula>
    <label>Average Revenue(USD M)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
