<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Required_Country</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISBLANK(TEXT(Country__c)), (RecordType.Name = &quot;International&quot;))</errorConditionFormula>
    <errorDisplayField>Country__c</errorDisplayField>
    <errorMessage>Country is required to create records.</errorMessage>
</ValidationRule>
