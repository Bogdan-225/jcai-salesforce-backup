<?xml version="1.0" encoding="UTF-8"?>
<DuplicateRule xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionOnInsert>Allow</actionOnInsert>
    <actionOnUpdate>Allow</actionOnUpdate>
    <alertText>This account may already exist. Please check the possible duplicates below before saving. | 同じ取引先が既に存在する可能性があります。既存レコードの利用をご検討ください。</alertText>
    <description>International accounts (record type International). Uses matching rule Account_Match_International: website/phone only together with a fuzzy company-name match. Alert + Report on create, Report on edit. dup_rules.docx v3 section 4.</description>
    <duplicateRuleFilter>
        <duplicateRuleFilterItems>
            <field>RecordTypeDevName__c</field>
            <operation>equals</operation>
            <value>International</value>
            <sortOrder>1</sortOrder>
            <table>Account</table>
        </duplicateRuleFilterItems>
    </duplicateRuleFilter>
    <duplicateRuleMatchRules>
        <matchRuleSObjectType>Account</matchRuleSObjectType>
        <matchingRule>Account_Match_International</matchingRule>
        <objectMapping xsi:nil="true"/>
    </duplicateRuleMatchRules>
    <isActive>true</isActive>
    <masterLabel>Account Duplicate Rule - International</masterLabel>
    <operationsOnInsert>Alert</operationsOnInsert>
    <operationsOnInsert>Report</operationsOnInsert>
    <operationsOnUpdate>Report</operationsOnUpdate>
    <securityOption>EnforceSharingRules</securityOption>
    <sortOrder>2</sortOrder>
</DuplicateRule>
